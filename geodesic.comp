#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
    float disk_inner_temp;  // Temperature at inner edge (Kelvin)
    float disk_outer_temp;  // Temperature at outer edge (Kelvin)
    float disk_angular_velocity; // Angular velocity factor
    float disk_time;        // Animation time
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
};

layout(std140, binding = 4) uniform RenderParams {
    int  stepsMoving;
    int  stepsStill;
    uint samplesMoving;
    uint samplesStill;
    float superSampleFactor;
    vec3 _padding;
} renderParams;

const float SagA_rs = 1.269e10;
const float D_LAMBDA = 1e7;
const double ESCAPE_R = 1e30;
const float C = 299792458.0; // Speed of light
const float K_B = 1.380649e-23; // Boltzmann constant
const float PLANCK = 6.62607015e-34;
const float C1 = 2.0 * 3.14159265359 * PLANCK * C * C;
const float C2 = PLANCK * C / K_B;
const int MAX_DISK_RINGS = 5;

// Globals to store hit info
vec4 objectColor = vec4(0.0);
vec3 hitCenter = vec3(0.0);
float hitRadius = 0.0;

struct Ray {
    float x, y, z, r, theta, phi;
    float dr, dtheta, dphi;
    float E, L;
};
Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;
    ray.r = length(pos);
    ray.theta = acos(pos.z / ray.r);
    ray.phi = atan(pos.y, pos.x);

    float dx = dir.x, dy = dir.y, dz = dir.z;
    ray.dr     = sin(ray.theta)*cos(ray.phi)*dx + sin(ray.theta)*sin(ray.phi)*dy + cos(ray.theta)*dz;
    ray.dtheta = (cos(ray.theta)*cos(ray.phi)*dx + cos(ray.theta)*sin(ray.phi)*dy - sin(ray.theta)*dz) / ray.r;
    ray.dphi   = (-sin(ray.phi)*dx + cos(ray.phi)*dy) / (ray.r * sin(ray.theta));

    ray.L = ray.r * ray.r * sin(ray.theta) * ray.dphi;
    float f = 1.0 - SagA_rs / ray.r;
    float dt_dL = sqrt((ray.dr*ray.dr)/f + ray.r*ray.r*(ray.dtheta*ray.dtheta + sin(ray.theta)*sin(ray.theta)*ray.dphi*ray.dphi));
    ray.E = f * dt_dL;

    return ray;
}

bool intercept(Ray ray, float rs) {
    return ray.r <= rs;
}
// Returns true on hit, captures center, radius, and base color
bool interceptObject(Ray ray) {
    vec3 P = vec3(ray.x, ray.y, ray.z);
    for (int i = 0; i < numObjects; ++i) {
        vec3 center = objPosRadius[i].xyz;
        float radius = objPosRadius[i].w;
        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter = center;
            hitRadius = radius;
            return true;
        }
    }
    return false;
}

void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, theta = ray.theta;
    float dr = ray.dr, dtheta = ray.dtheta, dphi = ray.dphi;
    float f = 1.0 - SagA_rs / r;
    float dt_dL = ray.E / f;

    d1 = vec3(dr, dtheta, dphi);
    d2.x = - (SagA_rs / (2.0 * r*r)) * f * dt_dL * dt_dL
         + (SagA_rs / (2.0 * r*r * f)) * dr * dr
         + r * (dtheta*dtheta + sin(theta)*sin(theta)*dphi*dphi);
    d2.y = -2.0*dr*dtheta/r + sin(theta)*cos(theta)*dphi*dphi;
    d2.z = -2.0*dr*dphi/r - 2.0*cos(theta)/(sin(theta)) * dtheta * dphi;
}
void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b;
    geodesicRHS(ray, k1a, k1b);

    ray.r      += dL * k1a.x;
    ray.theta  += dL * k1a.y;
    ray.phi    += dL * k1a.z;
    ray.dr     += dL * k1b.x;
    ray.dtheta += dL * k1b.y;
    ray.dphi   += dL * k1b.z;

    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * sin(ray.theta) * sin(ray.phi);
    ray.z = ray.r * cos(ray.theta);
}
bool crossesEquatorialPlane(vec3 oldPos, vec3 newPos) {
    bool crossed = (oldPos.y * newPos.y < 0.0);
    float r = length(vec2(newPos.x, newPos.z));
    return crossed && (r >= disk_r1 && r <= disk_r2);
}

// Convert temperature (Kelvin) to RGB color (blackbody radiation)
vec3 temperatureToColor(float temp) {
    if (temp < 1000.0) temp = 1000.0;
    if (temp > 40000.0) temp = 40000.0;
    
    // Approximate blackbody color using a simplified model
    float t = temp / 1000.0;
    
    float r, g, b;
    
    // Red component
    if (t < 66.0) {
        r = 255.0;
    } else {
        r = t - 60.0;
        r = 329.698727446 * pow(r, -0.1332047592);
        r = clamp(r, 0.0, 255.0);
    }
    
    // Green component
    if (t < 66.0) {
        g = t;
        g = 99.4708025861 * log(g) - 161.1195681661;
        g = clamp(g, 0.0, 255.0);
    } else {
        g = t - 60.0;
        g = 288.1221695283 * pow(g, -0.0755148492);
        g = clamp(g, 0.0, 255.0);
    }
    
    // Blue component
    if (t >= 66.0) {
        b = 255.0;
    } else {
        if (t <= 19.0) {
            b = 0.0;
        } else {
            b = t - 10.0;
            b = 138.5177312231 * log(b) - 305.0447927307;
            b = clamp(b, 0.0, 255.0);
        }
    }
    
    return vec3(r, g, b) / 255.0;
}

// Calculate relativistic Doppler beaming factor
float dopplerBeaming(vec3 diskPos, vec3 rayDir, vec3 camPos) {
    // Calculate disk velocity (tangential, orbiting around black hole)
    vec3 toCenter = normalize(-diskPos);
    vec3 tangent = vec3(-toCenter.z, 0.0, toCenter.x); // Perpendicular in xz plane
    
    // Angular velocity decreases with radius (Keplerian orbit)
    // v = sqrt(GM/r) for circular orbits
    float r = length(vec2(diskPos.x, diskPos.z));
    if (r < disk_r1) r = disk_r1; // Clamp to disk bounds
    
    // Calculate orbital velocity (non-relativistic approximation)
    // v = sqrt(G*M/r), but we'll use a scaled version
    float v_orbital = disk_angular_velocity * sqrt(SagA_rs / r);
    vec3 velocity = tangent * v_orbital;
    
    // Calculate relative velocity along ray direction to camera
    vec3 toCamera = normalize(camPos - diskPos);
    float v_parallel = dot(velocity, toCamera);
    
    // Relativistic Doppler factor: sqrt((1 + v/c) / (1 - v/c))
    // For v << c, this approximates to 1 + v/c
    float beta = v_parallel / C;
    
    // Clamp beta to avoid numerical issues
    beta = clamp(beta, -0.3, 0.3);
    
    // Relativistic Doppler beaming
    float doppler = sqrt((1.0 + beta) / (1.0 - beta));
    
    // Clamp to reasonable values and enhance effect
    doppler = clamp(doppler, 0.5, 3.0);
    
    // Boost the effect for more visible beaming
    return mix(1.0, doppler, 0.7);
}

// Get disk temperature at radius r (inner hotter, outer cooler)
float getDiskTemperature(float r) {
    float t = (r - disk_r1) / (disk_r2 - disk_r1);
    t = clamp(t, 0.0, 1.0);
    // Exponential falloff for more realistic temperature gradient
    t = pow(1.0 - t, 1.5);
    return mix(disk_outer_temp, disk_inner_temp, t);
}

// Calculate disk emission with multiple rings and structure
vec4 getDiskColor(vec3 diskPos, vec3 rayDir, vec3 camPos) {
    float r = length(vec2(diskPos.x, diskPos.z));
    float normalizedR = (r - disk_r1) / (disk_r2 - disk_r1);
    
    // Get temperature at this radius
    float temp = getDiskTemperature(r);
    
    // Base color from temperature
    vec3 baseColor = temperatureToColor(temp);
    
    // Add structure: multiple rings with varying intensity
    float ringPattern = sin(normalizedR * 15.0 + disk_time * 0.5) * 0.5 + 0.5;
    ringPattern = pow(ringPattern, 0.7);
    
    // Inner region: bright white/blue (hottest)
    if (normalizedR < 0.15) {
        baseColor = mix(vec3(0.8, 0.9, 1.0), baseColor, normalizedR / 0.15);
    }
    
    // Middle region: orange/yellow transition
    if (normalizedR > 0.15 && normalizedR < 0.5) {
        float t = (normalizedR - 0.15) / 0.35;
        baseColor = mix(baseColor, vec3(1.0, 0.6, 0.2), t * 0.5);
    }
    
    // Outer region: red (coolest)
    if (normalizedR > 0.7) {
        baseColor = mix(baseColor, vec3(1.0, 0.3, 0.1), (normalizedR - 0.7) / 0.3);
    }
    
    // Apply Doppler beaming (approaching side brighter)
    float doppler = dopplerBeaming(diskPos, rayDir, camPos);
    baseColor *= doppler;
    
    // Add radial brightness falloff
    float brightness = 1.0 - normalizedR * 0.3;
    brightness = pow(brightness, 0.8);
    
    // Apply ring pattern
    brightness *= (0.7 + ringPattern * 0.3);
    
    // Calculate intensity based on viewing angle
    vec3 diskNormal = vec3(0.0, 1.0, 0.0);
    vec3 toCamera = normalize(camPos - diskPos);
    float viewAngle = abs(dot(diskNormal, toCamera));
    brightness *= 0.3 + viewAngle * 0.7; // Edge-on is dimmer
    
    // Add glow effect for inner regions
    if (normalizedR < 0.3) {
        float glow = 1.0 - normalizedR / 0.3;
        baseColor += vec3(0.2, 0.3, 0.4) * glow * 0.5;
    }
    
    return vec4(baseColor * brightness, 1.0);
}

float radicalInverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley2d(uint i, uint N) {
    return vec2(float(i) / float(N), radicalInverse_VdC(i));
}

float starNoise(vec2 uv) {
    return fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);
}

vec3 computeBackground(vec2 screenUV) {
    vec3 background = vec3(0.008, 0.008, 0.015);
    float starField = 0.0;
    for (int i = 0; i < 4; ++i) {
        float sparkle = starNoise(screenUV * (6.0 + float(i) * 2.0) + float(i) * 13.37);
        starField += pow(smoothstep(0.8, 1.0, sparkle), 3.0) * (0.08 + 0.12 * float(i));
    }
    return background + vec3(starField);
}

vec3 acesTonemap(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec4 traceRay(vec3 dir, int steps, vec3 background) {
    objectColor = vec4(0.0);
    hitCenter = vec3(0.0);
    hitRadius = 0.0;

    Ray ray = initRay(cam.camPos, dir);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);

    bool hitBlackHole = false;
    bool hitObject    = false;

    int diskHits = 0;
    vec4 diskAccum = vec4(0.0);
    float diskWeight = 0.0;

    for (int i = 0; i < steps; ++i) {
        if (intercept(ray, SagA_rs)) {
            hitBlackHole = true;
            break;
        }

        vec3 oldPos = vec3(ray.x, ray.y, ray.z);
        rk4Step(ray, D_LAMBDA);
        vec3 newPos = vec3(ray.x, ray.y, ray.z);

        if (crossesEquatorialPlane(prevPos, newPos)) {
            vec3 diskPos = mix(prevPos, newPos, 0.5);
            vec4 diskColor = getDiskColor(diskPos, normalize(newPos - prevPos), cam.camPos);
            float weight = 1.0 / (1.0 + float(diskHits) * 0.3);
            diskAccum += diskColor * weight;
            diskWeight += weight;
            diskHits++;

            if (diskHits >= MAX_DISK_RINGS) {
                break;
            }
        }

        if (interceptObject(ray)) {
            hitObject = true;
            break;
        }

        prevPos = newPos;
        if (ray.r > ESCAPE_R) break;
    }

    vec4 color;
    if (hitBlackHole) {
        float glow = clamp((SagA_rs * 1.1 - ray.r) / (SagA_rs * 0.2), 0.0, 1.0);
        vec3 rim = mix(vec3(0.0), vec3(0.02, 0.03, 0.04), glow);
        color = vec4(rim, 1.0);
    } else if (diskHits > 0) {
        vec4 diskColor = diskAccum / max(diskWeight, 1.0);
        float glow = min(float(diskHits) / 3.0, 1.0);
        diskColor.rgb += vec3(0.1, 0.15, 0.2) * glow;
        diskColor.rgb = pow(diskColor.rgb, vec3(0.9));
        diskColor.rgb *= 1.25;
        color = diskColor;
    } else if (hitObject) {
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitCenter);
        vec3 V = normalize(cam.camPos - P);

        float ambient = 0.15;
        float diff = max(dot(N, V), 0.0);
        float intensity = ambient + (1.0 - ambient) * diff;

        vec3 diskGlow = vec3(0.05, 0.08, 0.1);
        vec3 shaded = objectColor.rgb * intensity + diskGlow;
        color = vec4(shaded, objectColor.a);
    } else {
        color = vec4(background, 1.0);
    }

    float luminance = dot(color.rgb, vec3(0.299, 0.587, 0.114));
    color.rgb = mix(vec3(luminance), color.rgb, 0.85);
    color.rgb = pow(color.rgb, vec3(0.95));
    return color;
}

void main() {
    ivec2 imgSize = imageSize(outImage);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= imgSize.x || pix.y >= imgSize.y) return;

    int steps = cam.moving ? renderParams.stepsMoving : renderParams.stepsStill;
    uint activeSamples = cam.moving ? renderParams.samplesMoving : renderParams.samplesStill;
    vec4 accumulated = vec4(0.0);

    for (uint sampleIdx = 0u; sampleIdx < activeSamples; ++sampleIdx) {
        vec2 jitter = vec2(0.0);
        vec2 sampleUV = (vec2(pix) + vec2(0.5)) / vec2(imgSize);

        if (activeSamples > 1u) {
            vec2 h = hammersley2d(sampleIdx, activeSamples) - vec2(0.5);
            jitter = h;
            sampleUV += h / vec2(imgSize);
        }

        float u = (2.0 * ((float(pix.x) + 0.5 + jitter.x)) / float(imgSize.x) - 1.0) * cam.aspect * cam.tanHalfFov;
        float v = (1.0 - 2.0 * ((float(pix.y) + 0.5 + jitter.y)) / float(imgSize.y)) * cam.tanHalfFov;
        vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);

        vec3 background = computeBackground(sampleUV);
        accumulated += traceRay(dir, steps, background);
    }

    vec4 color = accumulated / float(activeSamples);
    color.rgb = acesTonemap(color.rgb);
    imageStore(outImage, pix, color);
}
